# ---------------------------------------------------------------------------
# BAMBOO VILLAGE — environment configuration
# Copy this file to `.env.local` and fill in the real values.
# Everything here is OPTIONAL: the site runs without it, but WhatsApp
# one-tap sending and canonical SEO URLs need these to be set.
# ---------------------------------------------------------------------------

# WhatsApp Business number in FULL INTERNATIONAL FORMAT, digits only.
# No "+", no spaces, no dashes. Uganda example shape: 2567XXXXXXXX
# When this is unset, "Order via WhatsApp" still builds the full message and
# offers a copy-to-clipboard fallback instead of opening WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.bamboovillage.example
